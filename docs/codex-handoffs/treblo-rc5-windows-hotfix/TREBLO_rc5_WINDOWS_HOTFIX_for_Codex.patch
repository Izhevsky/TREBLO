diff --git a/app/midi_input_recovery.py b/app/midi_input_recovery.py
new file mode 100644
index 0000000..489574c
--- /dev/null
+++ b/app/midi_input_recovery.py
@@ -0,0 +1,140 @@
+"""Narrow compatibility adapter for malformed Standard MIDI key-signature metadata.
+
+MIDI meta 0xFF 0x59 contains a signed sharps/flats count (-7 .. +7) and
+mode (0 major, 1 minor). Some DAWs export invalid values (e.g. +14).
+Mido raises KeySignatureError *before* the canonical parser can see notes.
+
+Only on that exact exception, scan MIDI message boundaries, replace invalid
+key-signature payload bytes in a temporary memory copy, and parse with the
+unchanged canonical parser. Source MIDI bytes, exported exact_midi.mid, tempo,
+notes, velocities and timing never change. Bad key meta is reported, not treated
+as a musical key. Other malformed MIDI errors remain errors.
+"""
+from __future__ import annotations
+
+from mido.midifiles.meta import KeySignatureError
+
+from .midi_reader import parse_midi
+
+
+def _vlq(buf: bytes, cursor: int, limit: int) -> tuple[int, int]:
+    """Read a MIDI variable-length integer inside one track."""
+    value = 0
+    for _ in range(4):
+        if cursor >= limit:
+            raise ValueError("truncated MIDI variable-length integer")
+        c = buf[cursor]
+        cursor += 1
+        value = (value << 7) | (c & 0x7F)
+        if not (c & 0x80):
+            return value, cursor
+    raise ValueError("invalid MIDI variable-length integer (>4 bytes)")
+
+
+def _key_metadata_repair(original: bytes) -> tuple[bytes, list[dict], list[dict]]:
+    """Return sanitized copy, invalid entries and *all* key metadata positions."""
+    if original[:4] != b'MThd' or len(original) < 14:
+        raise ValueError("invalid MIDI header")
+    hsize = int.from_bytes(original[4:8], 'big')
+    if hsize < 6 or 8 + hsize > len(original):
+        raise ValueError("invalid MIDI header length")
+
+    patched = bytearray(original)
+    invalid: list[dict] = []
+    all_keys: list[dict] = []
+    pos = 8 + hsize
+    track_index = 0
+    while pos < len(original):
+        if pos + 8 > len(original):
+            raise ValueError("truncated MIDI chunk header")
+        kind = original[pos:pos + 4]
+        length = int.from_bytes(original[pos + 4:pos + 8], 'big')
+        pos += 8
+        limit = pos + length
+        if limit > len(original):
+            raise ValueError("truncated MIDI track")
+        if kind != b'MTrk':
+            # Auxiliary MIDI chunks are not part of note/message streams.
+            pos = limit
+            continue
+        cursor, tick, running = pos, 0, None
+        while cursor < limit:
+            delta, cursor = _vlq(original, cursor, limit)
+            tick += delta
+            if cursor >= limit:
+                raise ValueError("truncated MIDI status byte")
+            status = original[cursor]
+            if status < 0x80:
+                if running is None:
+                    raise ValueError("MIDI running status without prior channel status")
+                status = running
+            else:
+                cursor += 1
+                if 0x80 <= status <= 0xEF:
+                    running = status
+
+            if status == 0xFF:
+                if cursor >= limit:
+                    raise ValueError("truncated MIDI meta-event")
+                meta_type = original[cursor]
+                cursor += 1
+                size, cursor = _vlq(original, cursor, limit)
+                end = cursor + size
+                if end > limit:
+                    raise ValueError("truncated MIDI meta-event payload")
+                if meta_type == 0x59 and size == 2:
+                    sf_raw, mode = original[cursor], original[cursor + 1]
+                    sf = sf_raw if sf_raw < 128 else sf_raw - 256
+                    entry = {"track_id": track_index, "tick": tick,
+                             "signed_sharps_flats": sf, "mode": mode,
+                             "byte_offset": cursor,
+                             "invalid": not (-7 <= sf <= 7 and mode in (0, 1))}
+                    all_keys.append(entry)
+                    if entry['invalid']:
+                        patched[cursor:cursor + 2] = b'\x00\x00'
+                        invalid.append(entry)
+                cursor = end
+            elif status in (0xF0, 0xF7):
+                # SysEx includes a VLQ payload length.
+                size, cursor = _vlq(original, cursor, limit)
+                cursor += size
+            elif 0x80 <= status <= 0xEF:
+                channel_command = status & 0xF0
+                n_data = 1 if channel_command in (0xC0, 0xD0) else 2
+                cursor += n_data
+            else:
+                raise ValueError(f"unsupported MIDI status 0x{status:02x} during key metadata recovery")
+            if cursor > limit:
+                raise ValueError("MIDI message exceeds track boundary")
+        pos = limit
+        track_index += 1
+    return bytes(patched), invalid, all_keys
+
+
+def parse_midi_with_key_recovery(source: bytes, name: str = '<memory>') -> dict:
+    """Parse normally; repair invalid key metadata only after KeySignatureError."""
+    try:
+        return parse_midi(source, name=name)
+    except KeySignatureError:
+        repaired_bytes, invalid, all_keys = _key_metadata_repair(source)
+        if not invalid:
+            raise
+        doc = parse_midi(repaired_bytes, name=name)
+        parsed_keys = doc['meta']['key_signatures']
+        if len(parsed_keys) != len(all_keys) or any(
+            item['track_id'] != found['track_id'] or item['tick'] != found['tick']
+            for item, found in zip(parsed_keys, all_keys)
+        ):
+            raise ValueError("key signature recovery audit failed: metadata positions changed")
+        doc['meta']['key_signatures'] = [
+            item for item, found in zip(parsed_keys, all_keys) if not found['invalid']
+        ]
+        doc['meta']['invalid_key_signatures'] = invalid
+        for item in invalid:
+            doc['warnings'].append(
+                "Invalid MIDI key-signature metadata ignored at "
+                f"track {item['track_id']} tick {item['tick']}: "
+                f"sf={item['signed_sharps_flats']} mode={item['mode']}. "
+                "Original source bytes preserved; notes/tempo/timing unchanged."
+            )
+        return doc
