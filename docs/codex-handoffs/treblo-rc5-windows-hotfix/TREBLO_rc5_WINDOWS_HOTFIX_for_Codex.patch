@@ -0,0 +1,93 @@
+"""Bad key metadata in 3rd-party MIDI cannot block note-accurate conversion."""
+import hashlib
+import json
+import mido
+import pytest
+from fastapi.testclient import TestClient
+from mido.midifiles.meta import KeySignatureError
+
+from app.midi_reader import parse_midi
+from app.midi_input_recovery import parse_midi_with_key_recovery, _key_metadata_repair
+from app.build_info import BUILD_ID
+from app.server import app
+from app.cli import run_pipeline
+
+
+def fixture_bad_key(*, malformed=b'\x0e\x00'):
+    midi=mido.MidiFile(type=1,ticks_per_beat=480)
+    track=mido.MidiTrack(); midi.tracks.append(track)
+    track.append(mido.MetaMessage('track_name', name='Rhodes'))
+    track.append(mido.MetaMessage('set_tempo',tempo=600001,time=0))
+    track.append(mido.MetaMessage('key_signature',key='C',time=0))
+    track.append(mido.Message('note_on',channel=0,note=60,velocity=97,time=12))
+    track.append(mido.Message('note_off',channel=0,note=60,velocity=0,time=180))
+    track.append(mido.MetaMessage('key_signature',key='Am',time=0))
+    track.append(mido.Message('note_on',channel=0,note=64,velocity=78,time=64))
+    track.append(mido.Message('note_off',channel=0,note=64,velocity=0,time=231))
+    track.append(mido.MetaMessage('end_of_track',time=0))
+    import io
+    buf=io.BytesIO();midi.save(file=buf)
+    raw=buf.getvalue()
+    marker=b'\xff\x59\x02\x00\x00'
+    assert raw.count(marker)==1
+    bad=raw.replace(marker,b'\xff\x59\x02'+malformed,1)
+    return raw,bad
+
+
+def test_mido_rejects_14_sharps_reproduction():
+    _,bad=fixture_bad_key()
+    with pytest.raises(KeySignatureError, match='14 sharps'):
+        parse_midi(bad)
+
+
+def test_recovery_keeps_every_original_note_and_good_key():
+    clean,bad=fixture_bad_key()
+    expected=parse_midi(clean)
+    patched, ignored, allkeys = _key_metadata_repair(bad)
+    assert len(patched)==len(bad)
+    assert len(ignored)==1 and len(allkeys)==2
+    assert sum(a!=b for a,b in zip(patched,bad))==1
+    assert patched==clean
+    doc=parse_midi_with_key_recovery(bad, name='RHODES.mid')
+    assert doc['notes']==expected['notes']
+    assert doc['tempo_map']==expected['tempo_map']
+    assert doc['control_changes']==expected['control_changes']
+    assert doc['tracks']==expected['tracks']
+    assert doc['meta']['key_signatures']==expected['meta']['key_signatures'][1:]
+    assert doc['meta']['invalid_key_signatures'][0]['signed_sharps_flats']==14
+    assert any('sf=14' in x for x in doc['warnings'])
+
+
+def test_other_invalid_key_mode_recovered():
+    _,bad=fixture_bad_key(malformed=b'\x02\x09')
+    doc=parse_midi_with_key_recovery(bad)
+    assert len(doc['notes'])==2
+    assert doc['meta']['invalid_key_signatures'][0]['mode']==9
+
+
+def test_good_midi_no_change():
+    good,_=fixture_bad_key()
+    assert parse_midi_with_key_recovery(good)==parse_midi(good)
+
+
+def test_pipeline_compact_bad_metadata_preserves_exact_source(tmp_path):
+    good,bad=fixture_bad_key()
+    result=run_pipeline(midi_bytes=bad,midi_name='RHODES.mid',outdir=tmp_path,modes=('compact',),sound_mode='native')
+    assert (tmp_path/'exact_midi.mid').read_bytes()==bad
